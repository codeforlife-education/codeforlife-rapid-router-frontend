<xml xmlns="http://www.w3.org/1999/xhtml">
  <block type="start" deletable="false" x="100" y="100">
    <next>
      <block type="controls_whileUntil">
        <field name="MODE">UNTIL</field>
        <value name="BOOL">
          <block type="at_destination"></block>
        </value>
        <statement name="DO">
          <block type="controls_whileUntil">
            <field name="MODE">WHILE</field>
            <value name="BOOL">
              <block type="logic_negate">
                <value name="BOOL">
                  <block type="dead_end"></block>
                </value>
              </block>
            </value>
            <statement name="DO">
              <block type="controls_whileUntil">
                <field name="MODE">WHILE</field>
                <value name="BOOL">
                  <block type="road_exists">
                    <field name="CHOICE">RIGHT</field>
                  </block>
                </value>
                <statement name="DO">
                  <block type="turn_right"></block>
                </statement>
                <next>
                  <block type="controls_whileUntil">
                    <field name="MODE">WHILE</field>
                    <value name="BOOL">
                      <block type="road_exists">
                        <field name="CHOICE">FORWARD</field>
                      </block>
                    </value>
                    <statement name="DO">
                      <block type="move_forwards"></block>
                    </statement>
                  </block>
                </next>
              </block>
            </statement>
            <next>
              <block type="turn_around"></block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>